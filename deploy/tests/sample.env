# Fake values for every variable in /etc/gymnotebook/.env
# (specs/005-upcloud-migration/contracts/server-env.md), so CI can run
# `docker compose config` on deploy/compose.prod.yml without the real file.
#
# It must never hold a real value. Everything here is obviously fake.

ConnectionStrings__Default=Host=db.invalid;Port=5432;Database=gymnotebook;Username=gymnotebook;Password=not-a-password;SSL Mode=VerifyFull;Root Certificate=/etc/gymnotebook/upcloud-ca.pem;Maximum Pool Size=10
Jwt__Secret=not-a-secret-not-a-secret-not-a-secret
Jwt__ExpiryMinutes=30
CORS_ORIGINS=https://gymnotebook.fit
PRIVACY_LIFECYCLE_ENABLED=false
Email__Backend=resend
EMAIL_FROM=Gym Notebook <no-reply@example.invalid>
APP_URL=https://gymnotebook.fit
RESEND_API_KEY=not-a-key
TURNSTILE_SECRET_KEY=not-a-key
TURNSTILE_HOSTNAMES=gymnotebook.fit
# Read by compose.prod.yml for gym-web, not by gym-api.
TURNSTILE_SITE_KEY=not-a-site-key

# Normally in /var/lib/gymnotebook/image-tag.env, written by deploy.sh.
IMAGE_TAG=main-0000000000000000000000000000000000000000
